{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sha256",
            "type": "shell",
            "command": "clang",
            "args": [
                "-std=c11",
                "-O2",
                "-g",
                "${workspaceFolder}/main.c",
                "-o",
                "${workspaceFolder}/sha256"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
